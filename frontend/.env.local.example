# Alchemy RPC URL for Robinhood Chain Testnet
# Get from: https://dashboard.alchemy.com — create app on "Robinhood Chain Testnet"
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY

# Deployed contract addresses (Robinhood Chain Testnet)
# These are already filled with the deployed addresses — no change needed
NEXT_PUBLIC_SIGNAL_REGISTRY_ADDRESS=0x09522dB7a983a675ba4E19BC9bc0896110b80C6A
NEXT_PUBLIC_SUBSCRIPTION_MANAGER_ADDRESS=0x566BEAa729E8E1e6cde30446546279BD30e5630d
NEXT_PUBLIC_MOCK_CONSUMER_ADDRESS=0x6114270e211C2cd5542D9972caF6F0D51FbA7105

# Alchemy Notify webhook signing key
# Set after creating a webhook in Alchemy dashboard (Address Activity on SignalRegistry)
ALCHEMY_NOTIFY_SECRET=your_webhook_signing_key

# Pre-cached signal IDs for judge preview (comma-separated)
# Set after keeper has produced at least 1 signal
NEXT_PUBLIC_SAMPLE_SIGNAL_IDS=1,2,3,4
